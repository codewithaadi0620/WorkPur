{
  "name": "freelancehub-backend",
  "version": "1.0.0",
  "description": "FreelanceHub - Advanced Database Management System (ADBMS) Backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:init": "node src/utils/dbInit.js",
